<?php
require 'auth.php';
require '../config/db.php';

// Fetch applications
$stmt = $pdo->query("SELECT * FROM s1_applications ORDER BY id DESC");
$applications = $stmt->fetchAll(PDO::FETCH_ASSOC);

// Optional: show a status message from URL
$msg = isset($_GET['msg']) ? $_GET['msg'] : '';
?>
