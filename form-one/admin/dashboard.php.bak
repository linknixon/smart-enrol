<div class="container">

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="change_password.php" class="btn btn-outline-secondary btn-sm">Change Password</a>
    <div class="text-end">
        <span class="me-2 text-muted">Logged in as <?= $_SESSION['admin_username'] ?></span>
        <a href="logout.php" class="btn btn-outline-danger btn-sm">Logout</a>
    </div>
</div>
<a href="admission_list.php" class="btn btn-success btn-sm">View Admitted Students</a>
<a href="/form-five/admin/dashboard.php" class="btn btn-success btn-sm mb-3">Senior Five Dashboard</a>
<h3 class="mb-3 text-center">Senior One Applications</h3>

<?php if($msg): ?>
<div class="alert alert-success text-center">
    Application <?= htmlspecialchars($msg) ?> successfully.
</div>
<?php endif; ?>

<div class="mb-3 text-center">
    <a href="export_csv.php" class="btn btn-secondary btn-sm">Export Admitted Students (CSV)</a>
    <a href="export_pdf.php" class="btn btn-primary btn-sm">Download Admitted Students (PDF)</a>
</div>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
<thead class="table-dark">
<tr>
    <th>#</th>
    <th>Passport</th>
    <th>Name</th>
    <th>Index No</th>
    <th>Aggregates</th>
    <th>Division</th>
    <th>Parent</th>
    <th>NIN</th>
    <th>Phone</th>
    <th>Address</th>
    <th>Results</th>
    <th>Status</th>
    <th>Action</th>
</tr>
</thead>
<tbody>
<?php foreach($applications as $app): ?>
<tr>
    <td><?= $app['id'] ?></td>
    <td>
        <?php
        $passport_path = '../'.$app['passport_photo'];
        if(!empty($app['passport_photo']) && file_exists($passport_path)):
        ?>
            <img src="<?= $passport_path ?>" width="50" height="50" class="rounded-circle">
        <?php else: ?>N/A<?php endif; ?>
    </td>
    <td><?= htmlspecialchars($app['firstname'].' '.$app['surname']) ?></td>
    <td><?= htmlspecialchars($app['index_number']) ?></td>
    <td><?= $app['aggregates'] ?></td>
    <td><?= $app['division'] ?></td>
    <td><?= htmlspecialchars($app['parent_name']) ?></td>
    <td><?= htmlspecialchars($app['parent_nin']) ?></td>
    <td><?= htmlspecialchars($app['parent_phone']) ?></td>
    <td><?= htmlspecialchars($app['parent_address']) ?></td>
    <td>
        <?php $result_path='../'.$app['result_slip']; ?>
        <?php if(!empty($app['result_slip']) && file_exists($result_path)): ?>
            <a href="<?= $result_path ?>" target="_blank" class="btn btn-info btn-sm">View</a>
        <?php else: ?>N/A<?php endif; ?>
    </td>
    <td>
        <?php
        $status = isset($app['application_status']) ? strtolower($app['application_status']) : 'pending';
        ?>
        <span class="status-badge status-<?= $status ?>"><?= ucfirst($status) ?></span>
    </td>
    <td>
        <?php if($status=='pending'): ?>
            <a href="admit.php?id=<?= $app['id'] ?>" class="btn btn-success btn-sm">Admit</a>
            <a href="reject.php?id=<?= $app['id'] ?>" class="btn btn-danger btn-sm">Reject</a>
        <?php else: ?>
            <span class="text-muted">Completed</span>
        <?php endif; ?>
    </td>
</tr>
<?php endforeach; ?>
</tbody>
</table>
</div>
</div>

</body>
</html>
