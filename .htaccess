# Apache configuration for admissions portal
DirectoryIndex index.php index.html

<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

Options +FollowSymLinks

# Seamless backward compatibility: redirect legacy /admin/ requests to /app/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^admin/(.*)$ app/$1 [R=301,L]

    # Intercept direct public access to confidential candidate uploads and enforce authentication
    RewriteRule ^uploads/(results|parent_ids|documents)(/.*)?$ app/view_document.php?folder=$1&file=$2 [QSA,L]
</IfModule>
